@model DeliveryWebsite.Models.OrderModel

@{
    ViewData["Title"] = "طلب توصيل سريع";
}

<div class="container mt-5 mb-5">
    <div class="card shadow p-4">
        <h2 class="text-center mb-4 text-success">طلب توصيل سريع 🛵</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form asp-controller="Home" asp-action="Index" method="post">
            
            <div class="mb-3">
                <label class="form-label">الاسم الكريم:</label>
                <input type="text" asp-for="CustomerName" class="form-control" placeholder="أدخل اسمك" required />
            </div>

            <div class="mb-3">
                <label class="form-label">رقم التليفون:</label>
                <input type="text" asp-for="PhoneNumber" class="form-control" placeholder="03xxxxxx أو 70xxxxxx" required />
            </div>

            <div class="mb-3">
                <label class="form-label">العنوان / المنطقة:</label>
                <input type="text" asp-for="Location" class="form-control" placeholder="مثال: صيدا، الشارع الرئيسي" required />
            </div>

            <div class="mb-3">
                <label class="form-label">تفاصيل الطلب:</label>
                <textarea asp-for="OrderDetails" class="form-control" rows="3" placeholder="اكتب طلباتك هنا..." required></textarea>
            </div>

            <!-- قسم تحديد الموقع الجغرافي -->
            <div class="mb-3 bg-light p-3 rounded border">
                <label class="form-label fw-bold text-primary">📍 تحديد الموقع (لترسيم طريق التوصيل بدقة):</label>
                <div class="input-group">
                    <input type="text" id="statusText" class="form-control bg-white" placeholder="اضغط زر تحديد الموقع بالأسفل" readonly />
                    <button type="button" class="btn btn-primary" onclick="getLocation()">
                        📍 حدد موقعي الآن
                    </button>
                </div>
                <small class="text-muted d-block mt-1">اضغط على الزر ليقوم النظام بأخذ إحداثيات موقعك وإرسالها برابط مباشر.</small>
            </div>

            <!-- حقول مخفية لحفظ خط العرض وخط الطول -->
            <input type="hidden" asp-for="Latitude" id="latitude" />
            <input type="hidden" asp-for="Longitude" id="longitude" />

            <div class="d-grid gap-2 mt-4">
                <button type="submit" class="btn btn-success btn-lg">إرسال الطلب عبر الواتساب</button>
            </div>
        </form>
    </div>
</div>

<script>
    function getLocation() {
        if (navigator.geolocation) {
            document.getElementById('statusText').value = "جاري تحديد الموقع...";
            navigator.geolocation.getCurrentPosition(
                function (position) {
                    document.getElementById('latitude').value = position.coords.latitude;
                    document.getElementById('longitude').value = position.coords.longitude;
                    document.getElementById('statusText').value = "تم تحديد الموقع بنجاح ✅";
                    alert("تم حفظ إحداثيات موقعك بنجاح! يمكنك إرسال الطلب الآن.");
                },
                function (error) {
                    alert("تعذر تحديد الموقع تلقائياً. تأكد من تفعيل الـ GPS والسماح للمتصفح.");
                    document.getElementById('statusText').value = "فشل التحديد، يرجى كتابة العنوان بوضوح";
                },
                { enableHighAccuracy: true }
            );
        } else {
            alert("متصفحك لا يدعم تحديد الموقع.");
        }
    }
</script>