@model DeliveryWebsite.Models.OrderModel

@{
    ViewData["Title"] = "طلب توصيل سريع";
}

<div class="container mt-5 mb-5">
    <div class="card shadow p-4">
        <h2 class="text-center mb-4 text-success">طلب توصيل سريع 🛵</h2>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger">@ViewBag.Error</div>
        }

        <form asp-controller="Home" asp-action="Index" method="post">
            
            <div class="mb-3">
                <label class="form-label">الاسم الكريم:</label>
                <input type="text" asp-for="CustomerName" class="form-control" placeholder="أدخل اسمك" required />
            </div>

            <div class="mb-3">
                <label class="form-label">رقم التليفون:</label>
                <input type="text" asp-for="PhoneNumber" class="form-control" placeholder="03xxxxxx أو 70xxxxxx" required />
            </div>

            <div class="mb-3">
                <label class="form-label">الموقع / العنوان التفصيلي:</label>
                <input type="text" asp-for="Location" id="locationInput" class="form-control" placeholder="المنطقة، الشارع، بناء..." required />
            </div>

            <div class="mb-3">
                <label class="form-label">تفاصيل الطلب:</label>
                <textarea asp-for="OrderDetails" class="form-control" rows="3" placeholder="اكتب تفاصيل طلبك هنا..." required></textarea>
            </div>

            <!-- خيارات تحديد الموقع -->
            <div class="mb-3">
                <label class="form-label">تحديد الموقع (اختر إحدى الطريقتين):</label>
                
                <!-- الطريقة الأولى: التحديد التلقائي -->
                <div class="input-group mb-2">
                    <input type="text" asp-for="Address" id="address" class="form-control" placeholder="اضغط زر تحديد موقعي الحالي" readonly />
                    <button type="button" class="btn btn-outline-primary" onclick="getCustomerLocation()">
                        📍 تحديد تلقائي
                    </button>
                </div>

                <!-- الطريقة الثانية: فتح خريطة جوجل يدوياً (لحل مشكلة الأذونات نهائياً) -->
                <div class="d-grid">
                    <a href="https://www.google.com/maps" target="_blank" class="btn btn-outline-secondary btn-sm">
                        🗺️ افتح خرائط جوجل، انسخ رابط موقعك، والصقه في حقل العنوان التفصيلي أعلى
                    </a>
                </div>
            </div>

            <!-- حقول مخفية للإحداثيات -->
            <input type="hidden" asp-for="Latitude" id="latitude" />
            <input type="hidden" asp-for="Longitude" id="longitude" />

            <div class="d-grid gap-2 mt-4">
                <button type="submit" class="btn btn-success btn-lg">إرسال الطلب عبر الواتساب</button>
            </div>
        </form>
    </div>
</div>

<script>
    function getCustomerLocation() {
        if (!navigator.geolocation) {
            alert("متصفحك لا يدعم تحديد الموقع الجغرافي.");
            return;
        }

        alert("📍 جاري تحديد موقعك، يرجى الموافقة على رسالة الإذن في المتصفح...");

        const options = {
            enableHighAccuracy: true,
            timeout: 10000,
            maximumAge: 0
        };

        navigator.geolocation.getCurrentPosition(
            function(position) {
                const lat = position.coords.latitude;
                const lng = position.coords.longitude;
                
                document.getElementById('latitude').value = lat;
                document.getElementById('longitude').value = lng;
                document.getElementById('address').value = `خط العرض: ${lat}, خط الطول: ${lng}`;
                
                alert("✅ تم تحديد موقعك بنجاح!");
            },
            function(error) {
                let errorMsg = "❌ تعذر تحديد الموقع تلقائياً بسبب إعدادات المتصفح. يمكنك استخدام خيار (فتح خرائط جوجل) أدناه.";
                alert(errorMsg);
            },
            options
        );
    }
</script>